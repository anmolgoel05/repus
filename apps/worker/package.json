{
  "name": "@repus/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../tools/run-with-env.cjs --worker-db tsx watch src/main.ts",
    "build": "node ../../tools/run-with-env.cjs tsc -p tsconfig.json",
    "start": "node ../../tools/run-with-env.cjs --worker-db node dist/main.js",
    "test": "vitest run --config ../../vitest.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.723.0",
    "@repus/database": "*",
    "@repus/email-renderer": "*",
    "@repus/token-security": "*",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "zod": "^4.6.7",
    "@repus/import-storage": "*",
    "csv-parse": "^7.0.3",
    "@repus/validation": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
