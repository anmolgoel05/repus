{
  "name": "@repus/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../tools/run-with-env.cjs concurrently -k \"tsc --watch -p tsconfig.build.json\" \"node --watch dist/main.js\"",
    "build": "node ../../tools/run-with-env.cjs tsc -p tsconfig.build.json",
    "start": "node ../../tools/run-with-env.cjs node dist/main.js",
    "test": "vitest run --config ../../vitest.config.mts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "predev": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.723.0",
    "@repus/database": "*",
    "@repus/email-renderer": "*",
    "@repus/token-security": "*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.14.0",
    "zod": "^4.6.7",
    "@repus/import-storage": "*",
    "@repus/validation": "*",
    "bullmq": "^5.34.10",
    "csv-parse": "^7.0.3",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/sanitize-html": "^2.13.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5",
    "@types/multer": "^2.3.0"
  }
}
