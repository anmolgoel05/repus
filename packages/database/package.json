{
  "name": "@repus/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "npm run build -w @repus/validation",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @repus/validation",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "node ../../tools/run-with-env.cjs prisma generate && npm run build",
    "db:migrate": "node ../../tools/run-with-env.cjs --migration-db prisma migrate deploy",
    "db:studio": "node ../../tools/run-with-env.cjs --migration-db prisma studio",
    "test": "vitest run --config ../../vitest.config.mts"
  },
  "dependencies": {
    "@repus/validation": "*",
    "@prisma/client": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^7.10.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
